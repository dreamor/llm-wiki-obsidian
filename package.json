{
  "name": "llm-wiki-obsidian",
  "version": "1.2.0",
  "type": "module",
  "description": "Personal knowledge base management skill based on Karpathy's LLM Wiki pattern. Build and maintain a persistent wiki through Obsidian CLI.",
  "main": "dist/cli.js",
  "bin": {
    "wiki-lint": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "npx tsx src/cli.ts lint",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "knowledge-base",
    "wiki",
    "llm",
    "karpathy",
    "personal-knowledge"
  ],
  "homepage": "https://github.com/dreamor/llm-wiki-obsidian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamor/llm-wiki-obsidian.git"
  },
  "author": "Scott Wang",
  "license": "MIT",
  "skills": {
    "name": "llm-wiki-obsidian",
    "description": "Personal knowledge base management with Obsidian",
    "commands": [
      "organize knowledge base",
      "ingest",
      "query",
      "lint",
      "autoresearch",
      "sync clippings"
    ],
    "agents": [
      "claude-code",
      "cursor",
      "windsurf",
      "cline",
      "aider",
      "codex",
      "hermes",
      "openclaw",
      "copilot"
    ]
  },
  "devDependencies": {
    "typescript": "^5.4",
    "tsx": "^4.0",
    "@types/node": "^20.0"
  },
  "dependencies": {
    "commander": "^12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "skills/",
    "CLAUDE.md",
    "AGENTS.md",
    "README.md",
    "setup.sh",
    ".cursor/rules/",
    ".windsurf/rules/",
    ".hermes.md",
    ".github/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}